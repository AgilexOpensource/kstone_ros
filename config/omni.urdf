<?xml version="1.0"?>
<robot name="geometric_omni">
  <link name="base_link">
    <inertial><mass value="10"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.3"/></inertial>
    <visual><origin xyz="0 0 0.1"/><geometry><box size="0.5 0.4 0.2"/></geometry><material name="base"><color rgba="0.2 0.4 0.7 1"/></material></visual>
    <collision><origin xyz="0 0 0.1"/><geometry><box size="0.5 0.4 0.2"/></geometry></collision>
  </link>
  <link name="x_carriage">
    <inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry></visual>
  </link>
  <joint name="slide_x" type="prismatic"><parent link="base_link"/><child link="x_carriage"/><origin xyz="0 0 0.35"/><axis xyz="1 0 0"/><limit lower="-0.3" upper="0.3" effort="100" velocity="0.3"/></joint>
  <link name="y_carriage">
    <inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><box size="0.08 0.08 0.08"/></geometry></visual>
  </link>
  <joint name="slide_y" type="prismatic"><parent link="x_carriage"/><child link="y_carriage"/><axis xyz="0 1 0"/><limit lower="-0.3" upper="0.3" effort="100" velocity="0.3"/></joint>
  <link name="tool_link">
    <inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
    <visual><geometry><sphere radius="0.05"/></geometry><material name="tool"><color rgba="0.8 0.6 0.2 1"/></material></visual>
  </link>
  <joint name="slide_z" type="prismatic"><parent link="y_carriage"/><child link="tool_link"/><axis xyz="0 0 1"/><limit lower="-0.2" upper="0.3" effort="100" velocity="0.3"/></joint>
  <link name="finger_link">
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.02 0.02"/></geometry></visual>
  </link>
  <joint name="finger_joint" type="prismatic"><parent link="tool_link"/><child link="finger_link"/><axis xyz="0 1 0"/><limit lower="0" upper="0.04" effort="10" velocity="0.08"/></joint>
</robot>
