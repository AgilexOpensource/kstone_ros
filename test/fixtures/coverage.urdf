<?xml version="1.0"?>
<!-- Geometric mobile dual-arm model for kstone_ros coverage tests only: free root, locked wheels,
     prismatic and revolute joints, a fixed tool frame and coupled mimic fingers. -->
<robot name="kstone_ros_coverage">
  <link name="base_link"><inertial><mass value="20"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/></inertial><visual><origin xyz="0 0 0.1"/><geometry><box size="0.6 0.5 0.2"/></geometry></visual><collision><origin xyz="0 0 0.1"/><geometry><box size="0.6 0.5 0.2"/></geometry></collision></link>
  <link name="wheel_0"><inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial></link>
  <joint name="wheel_joint0" type="continuous"><parent link="base_link"/><child link="wheel_0"/><origin xyz="0.2 0.2 0.05"/><axis xyz="0 1 0"/><limit effort="50" velocity="10"/></joint>
  <link name="wheel_1"><inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial></link>
  <joint name="wheel_joint1" type="continuous"><parent link="base_link"/><child link="wheel_1"/><origin xyz="0.2 -0.2 0.05"/><axis xyz="0 1 0"/><limit effort="50" velocity="10"/></joint>
  <link name="wheel_2"><inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial></link>
  <joint name="wheel_joint2" type="continuous"><parent link="base_link"/><child link="wheel_2"/><origin xyz="-0.25 0 0.05"/><axis xyz="0 1 0"/><limit effort="50" velocity="10"/></joint>
  <link name="lift_link"><inertial><mass value="2"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial><visual><origin xyz="0 0 0.15"/><geometry><box size="0.15 0.15 0.3"/></geometry></visual><collision><origin xyz="0 0 0.15"/><geometry><box size="0.15 0.15 0.3"/></geometry></collision></link>
  <joint name="torso_lift" type="prismatic"><parent link="base_link"/><child link="lift_link"/><origin xyz="0 0 0.2"/><axis xyz="0 0 1"/><limit lower="0.0" upper="0.3" effort="50" velocity="0.2"/></joint>
  <link name="chest_link"><inertial><mass value="4"/><inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.04"/></inertial><visual><origin xyz="0 0 0.15"/><geometry><box size="0.2 0.3 0.3"/></geometry></visual><collision><origin xyz="0 0 0.15"/><geometry><box size="0.2 0.3 0.3"/></geometry></collision></link>
  <joint name="torso_pitch" type="revolute"><parent link="lift_link"/><child link="chest_link"/><origin xyz="0 0 0.3"/><axis xyz="0 1 0"/><limit lower="-0.3" upper="0.8" effort="50" velocity="1.0"/></joint>
  <link name="neck_link"><inertial><mass value="0.3"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial></link>
  <joint name="head_pan" type="revolute"><parent link="chest_link"/><child link="neck_link"/><origin xyz="0 0 0.35"/><axis xyz="0 0 1"/><limit lower="-1.0" upper="1.0" effort="50" velocity="1.5"/></joint>
  <link name="head_link"><inertial><mass value="0.8"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial><visual><origin xyz="0 0 0"/><geometry><sphere radius="0.08"/></geometry></visual><collision><origin xyz="0 0 0"/><geometry><sphere radius="0.08"/></geometry></collision></link>
  <joint name="head_tilt" type="revolute"><parent link="neck_link"/><child link="head_link"/><origin xyz="0 0 0.08"/><axis xyz="0 1 0"/><limit lower="-0.5" upper="0.8" effort="50" velocity="1.5"/></joint>
  <link name="l_shoulder"><inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial></link>
  <joint name="l_arm_joint1" type="revolute"><parent link="chest_link"/><child link="l_shoulder"/><origin xyz="0 0.3 0.25"/><axis xyz="0 1 0"/><limit lower="-2.0" upper="1.0" effort="50" velocity="2.0"/></joint>
  <link name="l_upper_arm"><inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.04" length="0.25"/></geometry></visual><collision><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.04" length="0.25"/></geometry></collision></link>
  <joint name="l_arm_joint2" type="revolute"><parent link="l_shoulder"/><child link="l_upper_arm"/><origin xyz="0 0 0"/><axis xyz="1 0 0"/><limit lower="-0.2" upper="1.5" effort="50" velocity="2.0"/></joint>
  <link name="l_forearm"><inertial><mass value="0.8"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial><visual><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.035" length="0.25"/></geometry></visual><collision><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.035" length="0.25"/></geometry></collision></link>
  <joint name="l_arm_joint3" type="revolute"><parent link="l_upper_arm"/><child link="l_forearm"/><origin xyz="0 0 -0.25"/><axis xyz="0 1 0"/><limit lower="0.1" upper="2.4" effort="50" velocity="2.0"/></joint>
  <link name="l_tool"><inertial><mass value="0.3"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial><visual><origin xyz="0 0 0"/><geometry><box size="0.06 0.08 0.06"/></geometry></visual><collision><origin xyz="0 0 0"/><geometry><box size="0.06 0.08 0.06"/></geometry></collision></link>
  <joint name="l_wrist" type="fixed"><parent link="l_forearm"/><child link="l_tool"/><origin xyz="0 0 -0.28"/></joint>
  <link name="l_finger1"><inertial><mass value="0.05"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial><visual><origin xyz="0 0 -0.025"/><geometry><box size="0.02 0.01 0.05"/></geometry></visual><collision><origin xyz="0 0 -0.025"/><geometry><box size="0.02 0.01 0.05"/></geometry></collision></link>
  <joint name="l_gripper" type="prismatic"><parent link="l_tool"/><child link="l_finger1"/><origin xyz="0 0.01 -0.03"/><axis xyz="0 1 0"/><limit lower="0.0" upper="0.04" effort="50" velocity="0.1"/></joint>
  <link name="l_finger2"><inertial><mass value="0.05"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial><visual><origin xyz="0 0 -0.025"/><geometry><box size="0.02 0.01 0.05"/></geometry></visual><collision><origin xyz="0 0 -0.025"/><geometry><box size="0.02 0.01 0.05"/></geometry></collision></link>
  <joint name="l_gripper_mimic" type="prismatic"><parent link="l_tool"/><child link="l_finger2"/><origin xyz="0 -0.01 -0.03"/><axis xyz="0 1 0"/><limit lower="-0.04" upper="0.0" effort="50" velocity="0.1"/><mimic joint="l_gripper" multiplier="-1.0" offset="0"/></joint>
  <link name="r_shoulder"><inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial></link>
  <joint name="r_arm_joint1" type="revolute"><parent link="chest_link"/><child link="r_shoulder"/><origin xyz="0 -0.3 0.25"/><axis xyz="0 1 0"/><limit lower="-2.0" upper="1.0" effort="50" velocity="2.0"/></joint>
  <link name="r_upper_arm"><inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.04" length="0.25"/></geometry></visual><collision><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.04" length="0.25"/></geometry></collision></link>
  <joint name="r_arm_joint2" type="revolute"><parent link="r_shoulder"/><child link="r_upper_arm"/><origin xyz="0 0 0"/><axis xyz="1 0 0"/><limit lower="-1.5" upper="0.2" effort="50" velocity="2.0"/></joint>
  <link name="r_forearm"><inertial><mass value="0.8"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial><visual><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.035" length="0.25"/></geometry></visual><collision><origin xyz="0 0 -0.125"/><geometry><cylinder radius="0.035" length="0.25"/></geometry></collision></link>
  <joint name="r_arm_joint3" type="revolute"><parent link="r_upper_arm"/><child link="r_forearm"/><origin xyz="0 0 -0.25"/><axis xyz="0 1 0"/><limit lower="0.1" upper="2.4" effort="50" velocity="2.0"/></joint>
  <link name="r_tool"><inertial><mass value="0.3"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial><visual><origin xyz="0 0 0"/><geometry><box size="0.06 0.08 0.06"/></geometry></visual><collision><origin xyz="0 0 0"/><geometry><box size="0.06 0.08 0.06"/></geometry></collision></link>
  <joint name="r_wrist" type="fixed"><parent link="r_forearm"/><child link="r_tool"/><origin xyz="0 0 -0.28"/></joint>
  <link name="r_finger1"><inertial><mass value="0.05"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial><visual><origin xyz="0 0 -0.025"/><geometry><box size="0.02 0.01 0.05"/></geometry></visual><collision><origin xyz="0 0 -0.025"/><geometry><box size="0.02 0.01 0.05"/></geometry></collision></link>
  <joint name="r_gripper" type="prismatic"><parent link="r_tool"/><child link="r_finger1"/><origin xyz="0 0.01 -0.03"/><axis xyz="0 1 0"/><limit lower="0.0" upper="0.04" effort="50" velocity="0.1"/></joint>
  <link name="r_finger2"><inertial><mass value="0.05"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial><visual><origin xyz="0 0 -0.025"/><geometry><box size="0.02 0.01 0.05"/></geometry></visual><collision><origin xyz="0 0 -0.025"/><geometry><box size="0.02 0.01 0.05"/></geometry></collision></link>
  <joint name="r_gripper_mimic" type="prismatic"><parent link="r_tool"/><child link="r_finger2"/><origin xyz="0 -0.01 -0.03"/><axis xyz="0 1 0"/><limit lower="-0.04" upper="0.0" effort="50" velocity="0.1"/><mimic joint="r_gripper" multiplier="-1.0" offset="0"/></joint>
</robot>
